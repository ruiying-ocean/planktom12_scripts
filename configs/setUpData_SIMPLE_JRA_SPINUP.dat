# -------------------------
#
# PlankTOM-SIMPLE Configuration File - JRA Forcing SPINUP
#
# All the paths and parameters needed for a spinup run of PlankTOM-SIMPLE on HALI.
# Derived from setUpData_TOM6_JRA_SPINUP.dat (same spinup settings: 1750-1940,
# cycling JRA forcing, EMPave_1749, output kept every 30 years); only the model,
# compiler-key, restart, namelist and XML entries differ.
#
# PlankTOM-SIMPLE: NPZD-like PlankTOM, 16 tracers (PO4, Si, DSi dropped 2026-09-16)
#   - 1 phytoplankton: PHY (with PHYFe, PHYCHL)
#   - 1 zooplankton:   ZOO
#   - 1 bacteria:      BAC
#   - detritus: DOC, POC, GOC (no ARA, GON, BSi)
#
# This file is read in by setUpRun.sh:
#   setUpRun.sh setUpData_SIMPLE_JRA_SPINUP.dat TOMS_RY_S000
#
# Lines with a preceding # will be ignored.
#
# -------------------------

# ========== RUN COMPONENTS ==========
# Model version to run (matches the opa_<model> line below)
model:SIMPLE

# Starting year of the run
yearStart:1750
yearEnd:1940

# Ocean timestep (s) and steps per year; update_timestep.sh rescales the namelist counters
timestep:5760
stepsPerYear:5475

# CO2 (VARIABLE or STATIC)
CO2:VARIABLE

# Dynamic or bias run (transient or spinup)
forcing_mode:spinup

# Forcing (NCEP or ERA or JRA)
forcing:JRA

# Tidyup options
spinupStart:1750
spinupEnd:1930

# Keep restarts and output frequency (years)
spinupRestartKeepFrequency:10
spinupOutputKeepFrequency:30
runRestartKeepFrequency:10
runOutputKeepFrequency:10

# Flags for keeping respective files (0 = delete, 1 = keep)
keepGrid_T:1
keepGrid_U:0
keepGrid_V:0
keepGrid_W:0
keepDiad:1
keepPtrc:1
keepIce:0
keepLimPhy:0
keepGflux:0

# Base directory for saving model run data
basedir:/gpfs/home/vhf24tbu/scratch/ModelRuns/

# Location of file with compiler keys
compilerKey:/gpfs/home/vhf24tbu/scratch/NEMO3.6-SIMPLE/CONFIG/ORCA2_LIM_PlankTOM/cpp_ORCA2_LIM_PlankTOM.fcm


# ========== INPUT RESOURCES ==========
# Restart files

# Passive tracers: the same 1947 PlankTOM12 restart the TOM6 run started from,
# mapped to the SIMPLE tracers (PHY = DIA+MIX+COC+PIC+PHA+FIX,
# ZOO = PRO+PTE+MES+GEL+CRU, PHYFe / PHYCHL = sums of the six Fe / Chl parts).
# Built with tests/tools/map_restart_nco.sh (or map_tom6_restart.py).
restart_trc.nc:/gpfs/home/vhf24tbu/input_data/model_restart/restart_19471231_trc_SIMPLE.nc

# Ice
restart_ice_in.nc:/gpfs/data/greenocean/software/resources/ModelResources/RestartFiles/restart_ice_v3.6.nc

# Restart for the physics parameters
restart.nc:/gpfs/data/greenocean/software/resources/ModelResources/RestartFiles/restart_19191231_opa_PT.nc

# Evaporation and precipitation balancing file
EMPaveFile:/gpfs/data/greenocean/software/resources/ModelResources/RestartFiles/EMPave_1749.dat

# Horizontal eddy viscosity coefficient
ahmcoef.nc:/gpfs/data/greenocean/software/resources/ModelResources/EddyViscCoeff/ahmcoef.nc

# Atmospheric CO2
atmco2.dat.variable:/gpfs/data/greenocean/software/resources/SOZONE_atmo/atmco2_ssp3-70.dat
atmco2.dat.static:/gpfs/data/greenocean/software/resources/ModelResources/AtmosCO2/atmco2_PT_v1_CONSTANT_1750.dat

# CFCs
atmco2cfc.dat:/gpfs/data/greenocean/software/resources/ModelResources/AtmosCO2/atmco2cfc_NEEDS_WORK.dat

# Bathymetry
bathy_level.nc:/gpfs/data/greenocean/software/resources/ModelResources/Bathymetry/bathy_level.nc
bathy_meter.nc:/gpfs/data/greenocean/software/resources/ModelResources/Bathymetry/bathy_meter.nc
bathy.orca.nc:/gpfs/data/greenocean/software/resources/ModelResources/Bathymetry/bathy.orca.nc

# Grid coordinates
coordinates.nc:/gpfs/data/greenocean/software/resources/ModelResources/GridCoordinates/coordinates.nc

# World Ocean Atlas
data_1m_potential_temperature_nomask.nc:/gpfs/data/greenocean/software/resources/ModelResources/Atlas/WOA01_ORCA2_1m_potemp.nc
data_1m_salinity_nomask.nc:/gpfs/data/greenocean/software/resources/ModelResources/Atlas/WOA01_ORCA2_1m_sal.nc

# Dust deposition (Fe source)
dust.orca.nc:/gpfs/data/greenocean/software/resources/ModelResources/Dust/dust.Jickells2005.times035.ORCA.nc

# Nitrogen deposition
ndeposition.nc:/gpfs/data/greenocean/software/resources/ModelResources/Dust/ndeposition.orca.nc

# River runoff
river.nc:/gpfs/data/greenocean/software/resources/ModelResources/River/river.nc
runoff_core_monthly.nc:/gpfs/data/greenocean/software/resources/ModelResources/River/runoff_core_monthly.nc

# Geothermal heating
geothermal_heating.nc:/gpfs/data/greenocean/software/resources/ModelResources/Geothermal/geothermal_heating.nc

# Tides
K1rowdrg.nc:/gpfs/data/greenocean/software/resources/ModelResources/Tides/K1rowdrg.nc
M2rowdrg.nc:/gpfs/data/greenocean/software/resources/ModelResources/Tides/M2rowdrg.nc

# Chlorophyll
chlorophyll.nc:/gpfs/data/greenocean/software/resources/ModelResources/Chlorophyll/chlorophyll.nc

# Masks
mask_itf.nc:/gpfs/data/greenocean/software/resources/ModelResources/Masks/mask_itf.nc


# ========== MODEL COMPONENTS ==========

# XIOS server
xios_server.exe:/gpfs/software/ada/xios/1.0/gcc-openmpi/xios_server.exe

# PlankTOM-SIMPLE executable
opa_SIMPLE:/gpfs/home/vhf24tbu/scratch/NEMO3.6-SIMPLE/CONFIG/ORCA2_LIM_PlankTOM/BLD/bin/nemo.exe

# ----- NAMELISTS -----
# Config namelist (shared with TOM6)
namelist_cfg:/gpfs/data/greenocean/software/CodeReview/KAR12/CONFIG/ORCA2_LIM_PlankTOM/EXP00/namelist_cfg

# PlankTOM-SIMPLE tracer list (16 tracers; a restart that still carries PO4, Si, DSi or sed_DSi is fine, trcrst ignores extra variables)
namelist_top_ref:/gpfs/home/vhf24tbu/scratch/NEMO3.6-SIMPLE/CONFIG/ORCA2_LIM_PlankTOM/EXP00/namelist_top_ref_simple

# JRA forcing namelists
namelist_ref_jra_restart:/gpfs/home/vhf24tbu/EXP00/namelist_ref_jra_restart
namelist_ref_jra_coldstart:/gpfs/home/vhf24tbu/EXP00/namelist_ref_jra_start
namelist_ref_jra_cycling:/gpfs/home/vhf24tbu/EXP00/namelist_ref_jra_looping

# TOP config namelist (shared with TOM6)
namelist_top_cfg:/gpfs/data/greenocean/software/CodeReview/KAR12/CONFIG/ORCA2_LIM_PlankTOM/EXP00/namelist_top_cfg

# PlankTOM-SIMPLE SMS namelist
namelist.trc.sms:/gpfs/home/vhf24tbu/scratch/NEMO3.6-SIMPLE/CONFIG/ORCA2_LIM_PlankTOM/EXP00/namelist.trc.sms_simple

# Ice namelists
namelist_ice_cfg:/gpfs/data/greenocean/software/CodeReview/KAR12/CONFIG/ORCA2_LIM_PlankTOM/EXP00/namelist_ice_cfg
namelist_ice_ref:/gpfs/data/greenocean/software/CodeReview/KAR12/CONFIG/ORCA2_LIM_PlankTOM/EXP00/namelist_ice_ref

# ----- XML -----
# PlankTOM-SIMPLE field definitions (complete file, all SIMPLE ids)
field_def.xml:/gpfs/home/vhf24tbu/scratch/NEMO3.6-SIMPLE/CONFIG/SHARED/field_def_planktom_simple.xml

# PlankTOM-SIMPLE output definition
iodef.xml:/gpfs/home/vhf24tbu/scratch/NEMO3.6-SIMPLE/CONFIG/ORCA2_LIM_PlankTOM/EXP00/iodef_simple.xml

# Domain definition
domain_def.xml:/gpfs/home/vhf24tbu/scratch/NEMO3.6-SIMPLE/CONFIG/ORCA2_LIM_PlankTOM/EXP00/domain_def.xml


# ========== ANALYSIS / VISUALISATION CONFIG ==========
# SIMPLE-specific TOML configs (PHY/ZOO/BAC, no PO4 or Si), resolved against
# analyser/ and visualise/ in the scripts repo
# (absolute paths also accepted).
analyser_config:analyser_config_nemo3.6_simple.toml
visualise_config:visualise_config_nemo3.6_simple.toml
